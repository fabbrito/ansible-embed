#cloud-config
# Rendered by Ansible — do not edit on host.
# Source: fabbrito.embed collection — roles/seed/templates/user-data.j2
#
# Every key's module is in the reference image's cloud.cfg; a key whose module
# the image does not run is ignored without a warning.
hostname: {{ seed_hostname }}
# Without it sudo warns "unable to resolve host".
manage_etc_hosts: true
{% if seed_timezone | length > 0 %}
timezone: {{ seed_timezone | to_json }}
{% endif %}
# Merges over the image's default_user, which keeps groups and shell. sudo is
# restated because Ansible needs it and a seed can strip it (Imager writes
# `sudo: null`). No password: the card is the way back in.
user:
  name: {{ seed_user }}
  lock_passwd: true
  sudo: ALL=(ALL) NOPASSWD:ALL
  ssh_authorized_keys:
{% for key in seed_authorized_keys %}
    - {{ key | to_json }}
{% endfor %}
ssh_pwauth: false
runcmd:
  # Raspberry Pi OS Lite ships SSH disabled.
  - [systemctl, enable, --now, ssh]
